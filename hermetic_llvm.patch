     }
 
     const char *link_output = required_env("LLVM_LINK_OUTPUT");
-    const char *dsymutil = required_env("LLVM_DSYMUTIL");
+    const char *dsymutil = resolve_tool(required_env("LLVM_DSYMUTIL"));
 
     char *dsym_args[] = {
         (char *)dsymutil,
@@ -95,7 +137,7 @@ int main(int argc, char **argv) {
