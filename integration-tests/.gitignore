# Model files (downloaded via download.sh)
fixtures/models/*/

# Keep models.json manifest
!fixtures/models/models.json

# Large binary files
*.onnx
# ...except the ~1 KB fake scorers the choice-scoring contract tests load,
# which provenance.json pins as committed fixtures.
!fixtures/choice/fake/*.onnx
# ...and the ~5 KB fake TTS models tts_phoneme_timings loads, written by
# tools/conformance/gen_fake_tts.py.
!fixtures/tts/fake/*/model.onnx
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.ggml

# But keep small vocab/config files if accidentally placed here
!*.json
!*.txt
!*.yaml
!*.yml

# Test outputs
test_output/
*.wav.out
*.mp3.out

# OS files
.DS_Store
Thumbs.db
