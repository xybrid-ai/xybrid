# Self-test of //bazel/zzz:isolate.bzl that needs no private input: a fake
# engine (fake_engine.c and its dead member fake_engine_unused.c) goes through
# the same zzz_isolated_engine rule as the real one, is linked with SDK-side
# code (host.c) into a shared library by the API-29 NDK toolchain, and
# :selftest fails the build unless
#   - the raw fake engine defines memcpy, strlen, expf and its variables
#     globally and carries .llvm_addrsig (so the test is not vacuous), the
#     isolated one defines only the zzz_embed_* API globally and the rest
#     locally, still imports write, and has no .llvm_addrsig left;
#   - the isolated object keeps its .tbss, .init_array and .eh_frame;
#   - the library imports memcpy, strlen, expf and write from bionic, exports
#     none of the fake runtime, and reaches the thread-local through TLSDESC
#     (PT_TLS, no TPREL relocation, no STATIC_TLS);
#   - the library does not reference fake_engine_unresolved, which only the
#     dead member calls: the final link (--gc-sections, --no-undefined, as
#     the AAR's) dropped that member, so ld -r kept its sections apart.
#
#   bazel build --platforms=//bazel/ggml:android_arm64_cpu_variants //bazel/zzz/selftest
#
# bazel.yml runs exactly that. Every target here is for that platform only
# (Android 10's native ELF TLS; API-28 builds would use emulated TLS), so a
# host wildcard build or analysis skips them as incompatible.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel/zzz:isolate.bzl", "ZZZ_EMBED_API", "zzz_isolated_engine")
load(":check.bzl", "isolation_selftest")

_AAR_ARM64 = [
    "@platforms//os:android",
    "@platforms//cpu:aarch64",
    "//bazel/toolchains/android:api29",
]

cc_library(
    name = "fake_engine",
    srcs = [
        "fake_engine.c",
        "fake_engine_unused.c",
    ],
    # No function or data sections, as much of a bundled runtime is built:
    # each member then has one plain .text, which ld -r would merge across
    # members without --unique. -faddrsig, which the NDK toolchain passes
    # anyway: :selftest needs the table the isolation must drop.
    copts = [
        "-fno-builtin",
        "-fno-function-sections",
        "-fno-data-sections",
        "-faddrsig",
    ],
    # The real engine's link flags (bazel/zzz/repositories.bzl), which the
    # isolated engine must carry over.
    linkopts = ["-lc", "-lm", "-ldl"],
    linkstatic = True,
    target_compatible_with = _AAR_ARM64,
)

zzz_isolated_engine(
    name = "fake_engine_isolated",
    api = ZZZ_EMBED_API,
    engine = ":fake_engine",
    target_compatible_with = _AAR_ARM64,
)

cc_binary(
    name = "libselftest.so",
    srcs = ["host.c"],
    copts = ["-fno-builtin"],
    linkshared = True,
    # libxybrid_bolt.so links with --gc-sections (bindings/kotlin), and the
    # NDK toolchain adds both to every link; spelled out because the
    # dead-member check of :selftest relies on them.
    linkopts = [
        "-Wl,--gc-sections",
        "-Wl,--no-undefined",
    ],
    target_compatible_with = _AAR_ARM64,
    deps = [":fake_engine_isolated"],
)

isolation_selftest(
    name = "selftest",
    api = ZZZ_EMBED_API,
    collected = ["fake_engine_unresolved"],
    engine = ":fake_engine_isolated",
    imports = ["expf", "memcpy", "strlen", "write"],
    library = ":libselftest.so",
    local = ["expf", "fake_engine_counter", "fake_engine_tls", "fake_engine_unused", "memcpy", "strlen"],
    raw = ":fake_engine",
    target_compatible_with = _AAR_ARM64,
    undefined = ["write"],
)
