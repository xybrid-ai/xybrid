load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:py_binary.bzl", "py_binary")

# The base's existing API28 toolchain remains untouched. This marker defaults
# to base_api, so no existing platform can match the optional API29 toolchain.
constraint_setting(name = "android_api", default_constraint_value = ":base_api")
constraint_value(name = "base_api", constraint_setting = ":android_api")
constraint_value(name = "api29", constraint_setting = ":android_api")

platform(
    name = "android_arm64_api29",
    parents = ["@rules_rs//rs/platforms:aarch64-linux-android"],
    constraint_values = [":api29"],
)

# Opt in with --extra_toolchains=<this label>; do not globally register it.
# Explicit extra toolchains take priority over registered API28 toolchains,
# which otherwise also match the marked companion platform. Only the child
# transitioned below gains :api29; SDK base siblings keep their original floor.
# Path follows rules_android_ndk0.1.5's inspected BUILD.ndk_clang.tpl and the
# existing pinned XYBRID_NDK_HOST_TAG=linux-x86_64 (Linux execution required).
toolchain(
    name = "api29_toolchain",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:android", "@platforms//cpu:aarch64", ":api29"],
    toolchain = "@androidndk_zzz_api29//toolchains/llvm/prebuilt/linux-x86_64:cc_toolchain_aarch64-linux-android",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

py_binary(name = "metadata", srcs = ["metadata.py"], tags = ["manual"])

genrule(
    name = "companion_metadata",
    srcs = ["//crates/zzz-sys:natives-manifest.json", "//crates/zzz-sys:zzz_pull.py"],
    outs = ["companion_metadata.h"],
    cmd = "$(execpath :metadata) --verifier $(execpath //crates/zzz-sys:zzz_pull.py) --manifest $(execpath //crates/zzz-sys:natives-manifest.json) --output $@",
    tools = [":metadata"],
    tags = ["manual"],
)

cc_binary(
    name = "libxybrid_zzz_tts.so",
    srcs = ["xybrid_tts_companion.c", "xybrid_tts_companion.h", ":companion_metadata"],
    additional_linker_inputs = ["exports.map"],
    copts = ["-std=c11", "-fvisibility=hidden", "-ffunction-sections", "-fdata-sections", "-Wall", "-Wextra", "-Werror"],
    deps = ["@zzz_android//:zzz"],
    linkopts = [
        "-Wl,--version-script,$(location exports.map)",
        "-Wl,--exclude-libs,ALL",
        "-Wl,--no-undefined",
        "-Wl,--gc-sections",
        "-Wl,-z,max-page-size=16384",
        "-Wl,-soname,libxybrid_zzz_tts.so",
        "-Wl,-s",
    ],
    linkshared = True,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:android", "@platforms//cpu:aarch64", ":api29"],
    tags = ["manual"],
)

platform_transition_filegroup(
    name = "companion",
    srcs = [":libxybrid_zzz_tts.so"],
    target_platform = ":android_arm64_api29",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# Explicit final-delivery input, not an AAR/Flutter/Unity activation. :notices
# is the shared exact14-file repository interface; schema4/current rc8 rejects
# its analysis. No raw engine archive/header/receipt is a public output here.
filegroup(
    name = "delivery_inputs",
    srcs = [":companion", "@zzz_android//:notices"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
