+
+        # Dawn sorts the port's input filenames before hashing their contents.
+        # Its own __file__ can be relative in Bazel actions while the other
+        # inputs are absolute. Canonicalize it so repository preparation and
+        # sandboxed linking use the same ordering and cached archive.
+        dawn_port = repository_ctx.path("cache/ports/emdawnwebgpu/emdawnwebgpu_pkg/emdawnwebgpu.port.py")
