# Copy this file to `local.properties` and fill in your key.
# `local.properties` is gitignored, so your key never lands in the repo.
#
# Android Studio reads it automatically — just press Run.
# Get a key at https://console.xybrid.dev.
#
# Leave it unset to run anonymously (on-device inference, no trace export).
# When set, the app also starts trace export to Xybrid.
xybrid.apiKey=sk_live_YOUR_KEY

# Optional: send traces to a self-hosted / tunneled OTLP trace endpoint
# (full URL, including /v1/traces). Leave unset to send them to Xybrid.
# xybrid.tracesEndpoint=https://your-platform.example.com/v1/traces
