# GATE 1: zero-dep binary. Proves the toolchain stack stands up (LLVM + rustc
# download, link a Rust binary for the host) WITHOUT needing Cargo.lock to resolve.
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@xybrid_version//:version.bzl", "XYBRID_VERSION")

rust_binary(
    name = "hello",
    version = XYBRID_VERSION,
    srcs = ["main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
)
