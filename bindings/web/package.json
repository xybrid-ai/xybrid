{
  "name": "@xybrid/web",
  "version": "0.11.0",
  "type": "module",
  "description": "Browser GGUF inference using Xybrid's Rust runtime and llama.cpp, with WASM SIMD and WebGPU.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime/*": "./dist/runtime/*",
    "./worker.js": "./dist/worker.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:example": "vite build --config example/vite.config.ts",
    "dev": "vite --config example/vite.config.ts",
    "dev:example": "vite --config example/vite.config.ts",
    "example:assets": "bun run example/scripts/prepare-assets.ts",
    "lint": "biome check .",
    "pack:release": "node scripts/check-pack.mjs",
    "runtime:build": "bun run scripts/build-runtime.ts",
    "size": "bun run scripts/measure-size.ts",
    "prebuild:example": "bun run example:assets",
    "predev": "bun run example:assets",
    "predev:example": "bun run example:assets",
    "test": "bun test test/metadata.test.ts test/llm.test.ts test/registry.test.ts test/huggingface.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xybrid-ai/xybrid.git",
    "directory": "bindings/web"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/xybrid-ai/xybrid/tree/master/bindings/web#readme",
  "bugs": {
    "url": "https://github.com/xybrid-ai/xybrid/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "ky": "^1.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "1.61.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
