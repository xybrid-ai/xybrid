# libxybrid_bolt.so is a build output produced from crates/xybrid-bolt via
# the Bazel AAR (see README) and built fresh by CI for releases. It is
# not committed. Neither are the runtime libraries staged beside it:
# libonnxruntime.so comes from vendor/ort-android and libc++_shared.so from the
# NDK sysroot (../.gitignore ignores libs/**/*.so). Only .gitkeep is tracked.
libxybrid_uniffi.so
