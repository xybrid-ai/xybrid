<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only to where the observability scenario's capture receiver
     listens: the emulator's alias for the host, or the device's own loopback
     forwarded to the host with `adb reverse` on a physical device. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
