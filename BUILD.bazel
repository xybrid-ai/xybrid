# PHASE-0 BAZEL SPIKE — throwaway. Root package exists so rules_rs can
# watch //:Cargo.lock and //:Cargo.toml as the dependency source of truth.
exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

# Host platform for Linux hosts (CI runners): rules_rs' experimental toolchains
# need an explicit host platform carrying a libc constraint on Linux. Activated
# by `common:linux` in .bazelrc (auto-applied via --enable_platform_specific_config).
# Mirrors hermetic-llvm/e2e/rules_rs.
platform(
    name = "host_linux_gnu",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.28",
    ],
    parents = ["@platforms//host"],
)

# GATE 3: vendored llama.cpp source (git submodule at vendor/llama-cpp), fed to
# the llama-cpp-sys build script so build.rs uses it instead of cloning (no network
# in Bazel actions). Owned by the root package since vendor/ has no BUILD of its own.
filegroup(
    name = "llama_src",
    srcs = glob(
        ["vendor/llama-cpp/**"],
        exclude = ["vendor/llama-cpp/**/BUILD", "vendor/llama-cpp/**/BUILD.bazel"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# OPTION B: build llama.cpp's libraries hermetically via its own CMakeLists,
# driven by rules_foreign_cc + the hermetic-llvm clang. Feature flags are MINE
# here (not build.rs's hardcoded ones) → CPU-only, Metal/Accelerate/BLAS OFF, so
# this is fully hermetic even on a Mac (no Xcode/xcrun). This is the clean
# "graph node" llama target the evaluation's Option B describes.
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

# Base llama cmake configuration (CPU-only, hermetic on desktop: Metal OFF).
# Desktop stays lean: TOOLS/COMMON OFF → just llama + ggml (the proven config).
_LLAMA_CACHE_ENTRIES = {
    "CMAKE_BUILD_TYPE": "Release",
    "BUILD_SHARED_LIBS": "OFF",
    "LLAMA_BUILD_EXAMPLES": "OFF",
    "LLAMA_BUILD_TESTS": "OFF",
    "LLAMA_BUILD_TOOLS": "OFF",
    "LLAMA_BUILD_SERVER": "OFF",
    "LLAMA_BUILD_COMMON": "OFF",
    "LLAMA_CURL": "OFF",
    "GGML_OPENMP": "OFF",
    "GGML_NATIVE": "OFF",  # reproducible: no -march=native
    "GGML_METAL": "OFF",  # <-- the key: no Apple GPU => no Xcode => hermetic
    "GGML_ACCELERATE": "OFF",
    "GGML_BLAS": "OFF",
    "GGML_CUDA": "OFF",
    "GGML_VULKAN": "OFF",
}

# Android extras. VISION: TOOLS+COMMON=ON unlock tools/ so the `mtmd` library
# (multimodal vision/audio) is built — mirrors build.rs's mobile vision path.
# TOOLS=ON also builds the tool executables (batched-bench, …); those need libc++
# explicitly linked (cargo's NDK does this automatically, rfcc's doesn't — the
# static libs we collect are unaffected). GGML_LLAMAFILE=OFF mirrors build.rs.
# Vision is Android-only (a mobile backend, like candle): desktop never builds
# mtmd, so the proven desktop chain is untouched.
_ANDROID_LLAMA = {
    "LLAMA_BUILD_TOOLS": "ON",
    "LLAMA_BUILD_COMMON": "ON",
    "GGML_LLAMAFILE": "OFF",
    "CMAKE_EXE_LINKER_FLAGS": "-lc++_shared",
}

# out_static_libs differs by platform: android adds libmtmd.a (vision).
_LLAMA_LIBS = [
    "libllama.a",
    "libggml.a",
    "libggml-base.a",
    "libggml-cpu.a",
]

cmake(
    name = "llama",
    # armv7: rfcc's crosstool has no CMAKE_SYSTEM_PROCESSOR mapping for armv7,
    # so cmake falls back to the EXEC machine's uname (x86_64 RBE worker) and
    # ggml's arch detection applies x86 SIMD flags (-mavx/-mf16c/…) to the arm
    # compile. CMAKE_SYSTEM_* set via cache_entries are absorbed into the
    # generated toolchain file (a plain -D is overridden by it), steering ggml
    # onto its ARM path. (aarch64/x86_64 map correctly on their own.)
    # Android mirrors build.rs's mobile cmake block: GGML_LLAMAFILE=OFF
    # (llamafile's sgemm uses NEON fp16 intrinsics armv7 doesn't have; today's
    # pipeline disables it on android across the board). armv7 additionally
    # needs the CMAKE_SYSTEM pair: rfcc only honors CMAKE_SYSTEM_PROCESSOR
    # (moving it into the generated crossfile) when CMAKE_SYSTEM_NAME is
    # user-set — without them ggml detects the EXEC worker's x86_64 and applies
    # x86 SIMD flags to the arm compile (verified in the configure log).
    cache_entries = select({
        "@rules_rs//rs/platforms/config:armv7-linux-androideabi": _LLAMA_CACHE_ENTRIES | _ANDROID_LLAMA | {
            "CMAKE_SYSTEM_NAME": "Linux",
            "CMAKE_SYSTEM_PROCESSOR": "arm",
        },
        "@rules_rs//rs/platforms/config:aarch64-linux-android": _LLAMA_CACHE_ENTRIES | _ANDROID_LLAMA,
        "@rules_rs//rs/platforms/config:x86_64-linux-android": _LLAMA_CACHE_ENTRIES | _ANDROID_LLAMA,
        "//conditions:default": _LLAMA_CACHE_ENTRIES,
    }),
    # (macOS-host PATH hack removed for the RBE/Linux test — on Linux workers
    # rfcc finds its own downloaded cmake; /opt/homebrew doesn't exist there.)
    lib_source = ":llama_src",
    # Build cmake's default `all` target — same as build.rs's vision path (it
    # sets TOOLS=ON and builds everything). Building only `mtmd` breaks cmake's
    # blanket `--install` step (it still runs the un-built tools' install rules).
    # SERVER=OFF already excludes the heavy cli/server; the rest are the standard
    # llama tools cargo compiles for android today, so `all` is proven to
    # cross-compile. We collect only the static libs we need below.
    out_static_libs = select({
        "@rules_rs//rs/platforms/config:aarch64-linux-android": ["libmtmd.a"] + _LLAMA_LIBS,
        "@rules_rs//rs/platforms/config:armv7-linux-androideabi": ["libmtmd.a"] + _LLAMA_LIBS,
        "@rules_rs//rs/platforms/config:x86_64-linux-android": ["libmtmd.a"] + _LLAMA_LIBS,
        "//conditions:default": _LLAMA_LIBS,
    }),
    visibility = ["//visibility:public"],
)

# --- ANDROID PoC: validate the NDK cc_toolchain with a trivial compile before
# wiring llama.cpp. Build with: bazel build //:ndk_smoke --platforms=//:android_arm64
load("@rules_cc//cc:defs.bzl", "cc_library")

platform(
    name = "android_arm64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

cc_library(
    name = "ndk_smoke",
    srcs = ["ndk_smoke.c"],
)

# Vendored ONNX Runtime (dlopened at runtime), per ABI that ships it — armv7
# has no vendored ORT (matches today's AAR). libc++_shared.so is NOT taken from
# vendor anymore: it comes from @androidndk's sysroot, version-matched to the
# NDK that linked the .so (see bindings/kotlin/BUILD.bazel).
filegroup(
    name = "ort_android_arm64",
    srcs = ["vendor/ort-android/arm64-v8a/libonnxruntime.so"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ort_android_x86_64",
    srcs = ["vendor/ort-android/x86_64/libonnxruntime.so"],
    visibility = ["//visibility:public"],
)
