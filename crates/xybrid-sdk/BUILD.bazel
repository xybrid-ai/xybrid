# GATE 5 — xybrid-sdk, the public Rust SDK (model load/run/stream + platform
# init). Free via @crates apart from one wrinkle: it depends on `//macros`
# (xybrid-macros), a proc-macro. rules_rust requires proc-macro crates in
# `proc_macro_deps`, but `all_crate_deps()` lumps everything into one list — so
# we lift `//macros` out. (sdk has no per-platform dep deltas, so the list is
# plain and safe to filter; the platform feature deltas live in crate_features.)
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@crates//:data.bzl", "DEP_DATA")
load("@rules_rs//rs/private:all_crate_deps.bzl", _all_crate_deps = "all_crate_deps")

PLATFORMS = [
    "@rules_rs//rs/platforms/config:aarch64-apple-darwin",
    "@rules_rs//rs/platforms/config:aarch64-linux-android",
    "@rules_rs//rs/platforms/config:x86_64-unknown-linux-gnu",
]

# Android's `platform-android` preset expansion, set directly (Bazel doesn't
# propagate the preset across crates). Mirrors sdk's platform-android.
_SDK_ANDROID = [
    "candle",
    "llm-llamacpp-vision",
    "platform-android",
]

# Filter out "//macros" from normal dependencies before generating the select() block
original_sdk_deps = DEP_DATA.get("crates/xybrid-sdk", {})
filtered_sdk_deps = dict(original_sdk_deps)
filtered_sdk_deps["deps"] = [d for d in original_sdk_deps.get("deps", []) if d != "//macros"]

# Flip 1 (desktop-linux parity): the `huggingface` feature needs the optional
# hf-hub dep, which the hub's per-platform resolution doesn't wire for linux
# (it records the preset name, not its optional-dep expansion). Same surgery
# precedent as the //macros filter above. hf-hub 0.5 resolves in the hub with
# exactly [rustls-tls, ureq] — no new inputs.
_SDK_LINUX_CFG = "@rules_rs//rs/platforms/config:x86_64-unknown-linux-gnu"
filtered_sdk_deps["deps_by_platform"] = dict(original_sdk_deps.get("deps_by_platform", {}))
filtered_sdk_deps["deps_by_platform"][_SDK_LINUX_CFG] = filtered_sdk_deps["deps_by_platform"].get(_SDK_LINUX_CFG, []) + [
    "@crates//:hf-hub-0.5.0",
]

rust_library(
    name = "xybrid-sdk",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    crate_features = [
        "default",
        "llm-llamacpp",
    ] + select({
        # Flip 1: the shipped cargo CLI uses platform-desktop = ort-download
        # (no-op marker) + llm-llamacpp-vision + huggingface. Bazel doesn't
        # expand presets across crates, so name the expansion explicitly.
        "@rules_rs//rs/platforms/config:x86_64-unknown-linux-gnu": [
            "platform-desktop",
            "llm-llamacpp-vision",
            "huggingface",
        ],
        "@rules_rs//rs/platforms/config:aarch64-apple-darwin": ["platform-macos"],
        "@rules_rs//rs/platforms/config:aarch64-linux-android": _SDK_ANDROID,
        "@rules_rs//rs/platforms/config:armv7-linux-androideabi": _SDK_ANDROID,
        "@rules_rs//rs/platforms/config:x86_64-linux-android": _SDK_ANDROID,
        "//conditions:default": [],
    }),
    proc_macro_deps = ["//macros"],
    deps = _all_crate_deps(
        filtered_sdk_deps,
        platforms = PLATFORMS,
        normal = True,
    ),
    visibility = ["//visibility:public"],
)
