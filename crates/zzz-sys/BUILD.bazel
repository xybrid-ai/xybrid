# The pinned engine archive remains an opt-in private build input.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@crates//:defs.bzl", "all_crate_deps")
load("@xybrid_version//:version.bzl", "XYBRID_VERSION")

exports_files(["natives-manifest.json"])

rust_library(
    name = "xybrid_zzz_sys",
    version = XYBRID_VERSION,
    srcs = glob(["src/**/*.rs"]),
    crate_features = select({"//:tts_zzz_enabled": ["bindings"], "//conditions:default": []}),
    edition = "2021",
    deps = all_crate_deps(normal = True) + select({
        "//bazel/zzz:linux_enabled": ["@zzz_linux//:zzz"],
        "//bazel/zzz:macos_enabled": ["@zzz_macos//:zzz"],
        "//bazel/zzz:android_enabled": ["@zzz_android//:zzz"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "//bazel/zzz:supported_enabled": [],
        "//:tts_zzz_enabled": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
alias(name = "zzz-sys", actual = ":xybrid_zzz_sys", visibility = ["//visibility:public"])
