# GATE 5 — xybrid-ffi (pre-bolt C ABI for Unity / C / C++).
#
# Builds the Rust cdylib + staticlib from @crates. Its build.rs only emits
# FOREIGN-side artifacts — `include/xybrid.h` via cbindgen, and (under the
# `csharp` feature) `NativeMethods.g.cs` via csbindgen. Neither is Rust source
# that lib.rs includes, so the cdylib/staticlib compiles WITHOUT running the
# build script. That header/C# codegen is the foreign-binding boundary and
# stays in cargo/xtask/CI (same boundary class as boltffi pack). build_deps
# (cbindgen, csbindgen) are therefore intentionally NOT wired here.
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("@crates//:defs.bzl", "all_crate_deps")

# cdylib — libxybrid_ffi.{so,dylib}
rust_shared_library(
    name = "xybrid_ffi_cdylib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "xybrid_ffi",
    edition = "2021",
    crate_features = ["default"],
    deps = all_crate_deps(normal = True),
    visibility = ["//visibility:public"],
)

# staticlib — libxybrid_ffi.a
rust_static_library(
    name = "xybrid_ffi_staticlib",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "xybrid_ffi",
    edition = "2021",
    crate_features = ["default"],
    deps = all_crate_deps(normal = True),
    visibility = ["//visibility:public"],
)
