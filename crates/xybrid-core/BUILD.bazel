# GATE 5 — xybrid-core, the workspace's center of gravity. Everything above
# llama transitively depends on it, so this BUILD gates the whole upper half.
#
# Clean rules_rs convention (no hand-listed deps): the @crates hub already
# resolved this crate's full dep set + features from the real Cargo.lock, so
# `all_crate_deps(normal = True)` returns them — internal path-deps as
# `//crates/...` labels and externals as exact-version `@crates//:...` labels,
# with per-platform deltas (Apple objc2/candle/coreml) folded into a select().
# Target name == package dir basename so `//crates/xybrid-core` resolves and
# the derived crate_name is `xybrid_core` — no `aliases()` needed.
#
# COMPILE CEILING (hard crate #3): `@crates//:ort` (ONNX Runtime) is a
# non-optional dep resolved with `ort-download` → its build script downloads
# prebuilt binaries over the network, which Bazel's sandbox / RBE blocks. This
# is the exact analog of the llama.cpp network ceiling. The hermetic fix mirrors
# llama Option A/B (decision, not wizardry):
#   - switch the resolved feature to `ort-dynamic` (ort/load-dynamic — no
#     build-time download; dlopen's libonnxruntime at runtime), or
#   - `crate.annotation(crate = "ort-sys", gen_build_script = False, ...)` and
#     feed a pinned onnxruntime as a Bazel input (the zstd-sys pattern rules_rs
#     auto-suggested).
# Until then this target ANALYZES clean but won't fully compile on RBE.
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@crates//:defs.bzl", "all_crate_deps")

rust_library(
    name = "xybrid-core",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    # Resolved from the real Cargo.lock by the @crates hub (DEP_DATA). Apple-only
    # accel features are gated to the darwin platform exactly as cargo unifies them.
    crate_features = [
        "default",
        "llm-llamacpp",
        "ort-download",  # <-- ceiling #3 lever: flip to "ort-dynamic" for the hermetic build (see header). Kept here to stay byte-identical to the hub's resolved feature set.
        "schema",
        "xybrid-llama",
        "xybrid-llama-sys",
    ] + select({
        "@rules_rs//rs/platforms/config:aarch64-apple-darwin": [
            "candle",
            "candle-core",
            "candle-hub",
            "candle-metal",
            "candle-nn",
            "ort-coreml",
        ],
        "//conditions:default": [],
    }),
    deps = all_crate_deps(normal = True),
    visibility = ["//visibility:public"],
)
