{
  "config": {
    "content_capture": "span_only",
    "logs": true,
    "max_content_attribute_bytes": 16384,
    "max_traversal_bytes": 1024,
    "redact_substrings": [
      "secret"
    ],
    "redaction_rules": [
      {
        "find": "[REDACTED]",
        "replace": "<r>",
        "type": "replace_literal"
      },
      {
        "find": "sk-live-123",
        "replace": "[KEY]",
        "type": "replace_literal"
      },
      {
        "find": "[KEY]",
        "replace": "<key>",
        "type": "replace_literal"
      },
      {
        "key": "gen_ai.system_instructions",
        "type": "omit_attribute"
      },
      {
        "key": "gen_ai.prompt.variable.user_id",
        "type": "omit_attribute"
      },
      {
        "find": "<<expand>>",
        "replace": "################################################################################################################################################################################################################################################################################################################################################################################################################",
        "type": "replace_literal"
      }
    ]
  },
  "description": "Declarative rules run after the callback redactor and before truncation: ordered literal replacements apply to every JSON string value (each rule sees the previous rule's output; object keys, numbers and booleans are untouched), and omit_attribute drops exactly the named governed key without marking it truncated. A rule expansion beyond the traversal budget fails closed. Error messages follow the same rules.",
