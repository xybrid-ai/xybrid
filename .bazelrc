# PHASE-0 BAZEL SPIKE — throwaway. See .context/bazel-hermetic-evaluation.md.
# Mirrors hermetic-llvm/e2e/rules_rs/.bazelrc (known-good rules_rs + hermetic-llvm config).

# rules_cc on macOS: cc-rs (build scripts) breaks with libtool as archiver.
common --@rules_cc//cc/toolchains/args/archiver_flags:use_libtool_on_macos=False
# rules_rust allocator-library handling used by the known-good e2e config.
common --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols

# Android NDK location for rules_android_ndk (local NDK r27). On RBE the NDK must
# instead be present on the Linux worker (a later gate).
common --repo_env=ANDROID_NDK_HOME=/Users/glennsonna/Library/Android/sdk/ndk/27.0.12077973

# On Linux hosts, rules_rs' experimental toolchains need an explicit host platform
# with libc constraints. (No-op on macOS host.)
common:linux --host_platform=//:host_linux_gnu

# Local disk cache so we can MEASURE warm-cache restore across `bazel clean`.
# (Kept under .context so it's ignored by git + bazel.)
build --disk_cache=.context/bazel-disk-cache

# --- Remote (BuildBuddy RBE): creds + remote flags live in a GITIGNORED file so
# the API key never enters a committable file. Activate with `--config=remote`.
try-import %workspace%/.context/buildbuddy.bazelrc
